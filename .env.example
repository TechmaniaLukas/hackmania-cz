# ─────────────────────────────────────────────────────────────
# Hackmania — environment variables
# Zkopíruj do .env.local pro dev, nahraj do Vercel project settings pro prod.
# ─────────────────────────────────────────────────────────────

# ─── Convex (databáze + queries) ─────────────────────────────
# Vyplní se automaticky při prvním `npx convex dev`. Pro produkci
# nastav `npx convex deploy` URL (https://xxxxx.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=

# Interní Convex token (jen pro CLI deploy z CI; lokálně netřeba)
# CONVEX_DEPLOY_KEY=

# ─── Resend (kontaktní formulář + newsletter) ────────────────
# https://resend.com → API Keys. Bez klíče formulář funguje v dev módu
# (success v UI, e-mail se neodešle).
RESEND_API_KEY=

# Volitelně přepiš výchozí "From" adresu (default: Hackmania <onboarding@resend.dev>)
# Aby fungovala vlastní doména, ověř ji v Resend Settings → Domains.
CONTACT_FROM="Hackmania web <web@hackmania.cz>"

# ─── Plausible analytics (volitelné) ─────────────────────────
# Pokud máš self-hosted Plausible, sem doplň URL endpointu.
# Default: https://plausible.io
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hackmania.cz
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# ─── Site URL (jen v non-Vercel buildech) ────────────────────
# Vercel automaticky nastaví VERCEL_URL, takže obvykle netřeba.
# NEXT_PUBLIC_SITE_URL=https://hackmania.cz
